# Explicit local development demo only; set true to enable. Never enabled in production.
APP_DEMO_MODE=
# Supabase project URL; server only.
SUPABASE_URL=
# Supabase anonymous/publishable key used only by server request-scoped client.
SUPABASE_ANON_KEY=
# Supabase service role: server-only account deletion, never general CRUD.
SUPABASE_SERVICE_ROLE_KEY=
# Phase 2: OpenAI server API key. Not used in phase 1.
OPENAI_API_KEY=
# Phase 2: model identifier, configurable. Not used in phase 1.
OPENAI_MODEL=
# Phase 3: Web Push VAPID keys and contact subject. Not used in phase 1.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Public application origin (scheme + hostname + port) for CSRF checks behind a proxy.
APP_ORIGIN=
